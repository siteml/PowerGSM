<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!--
      Same NETSDK1047 reasoning as GSM.Node.vbproj: a publish that
      pins -p:RuntimeIdentifier=win-x64 while skipping the per-publish
      restore (the release workflow does both) needs the
      net8.0-windows/win-x64 slot to exist in obj/project.assets.json,
      which only happens if RuntimeIdentifiers is declared here.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace></RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <ApplicationIcon>PowerGSM.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PowerGSM.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ExcludeFromSingleFile keeps GSM.Contracts.dll as a loose file
      next to the .exe in single-file publish output. This is required
      because PluginRegistry uses Roslyn at runtime to compile plugins,
      and Roslyn needs Contracts as a MetadataReference. In a bundled
      single-file build, Assembly.Location returns an empty string for
      Contracts and there's no reliable way to feed it to Roslyn from
      the bundle. Keeping Contracts loose costs ~10KB on disk and
      sidesteps the entire problem.
    -->
    <ProjectReference Include="..\GSM.Contracts\GSM.Contracts.vbproj">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </ProjectReference>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\GSM.PluginsSource\*.vb">
      <Link>Plugins\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="ARRCON.exe" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="EntityFrameworkCore.VisualBasic" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Basic.Reference.Assemblies" Version="1.8.5" />
    <PackageReference Include="HtmlRenderer.WinForms" Version="1.5.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.11.0" />

    <!--
      Explicit pins on the CodeAnalysis transitive closure. Without
      these, Microsoft.EntityFrameworkCore.Tools drags in
      Microsoft.CodeAnalysis.CSharp 4.5.0 (and Workspaces 4.5.0),
      which in turn pin Microsoft.CodeAnalysis.Common to 4.5.0 —
      conflicting with the higher version required by
      CodeAnalysis.VisualBasic above and by Basic.Reference.Assemblies.
      Forcing the CSharp/Workspaces packages to the same 4.11.0 floor
      aligns the whole Roslyn surface on one version.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.11.0" />

    <PackageReference Include="NCrontab" Version="3.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <!--
      Phase 7-3 round 2 — embedded-browser web-session capture for
      utility plugins (Decision 7a). Manager-only dependency: plugins
      never reference WebView2; they request a capture through the
      gated IUtilityContext and the Manager renders the dialog.
      Requires the WebView2 Evergreen Runtime on the machine
      (ubiquitous with modern Edge); the dialog degrades to a
      "runtime missing" message when absent. The native
      WebView2Loader.dll ships as a loose file next to the exe in
      single-file publishes (IncludeNativeLibrariesForSelfExtract is
      already false), same pattern as the SQLite native library.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />

    <!--
      Phase 5d — Discord bot integration. DSharpPlus 4.x is the
      established stable line: single package, mature gateway/REST
      surface, well-documented, .NET 8 supported. The 5.x line was
      still mid-rollout when this dependency was added, with split
      sub-packages still settling; we'll revisit when 5.x is the
      obvious choice for new projects. Bumping within the 4.x line
      is safe (semver-respecting); jumping to 5.x will be a planned
      migration.
    -->
    <PackageReference Include="DSharpPlus" Version="4.5.0" />
    <!--
      Phase 5d-4 — slash command framework on top of DSharpPlus.
      Same 4.5.0 floor as the core package so the two move together.
      Version drift between DSharpPlus and DSharpPlus.SlashCommands
      causes hard-to-diagnose runtime failures in the extension's
      Ready-event hook.
    -->
    <PackageReference Include="DSharpPlus.SlashCommands" Version="4.5.0" />
  </ItemGroup>

  <!--
    GSM.Watchdog co-location (Phase 5m-3)

    The watchdog is a sibling supervisor process, NOT a referenced
    assembly: the Manager and watchdog communicate only via process
    launch, exit codes, and a shared mutex name (hardcoded in both,
    by design — no shared library). Same shape as the
    GSM.Node -> GSM.CtrlCSender deployment:
      * ReferenceOutputAssembly=false        — don't link the Exe as a managed reference
      * Private=false                        — keep it out of our reference/publish closure (copied explicitly below)
      * SkipGetTargetFrameworkProperties=true — silence the TFM mismatch (Manager is net8.0-windows, watchdog is net8.0)
      * UndefineProperties=RuntimeIdentifier  — don't propagate the Manager's RID into the watchdog's regular Build
    This is a build-order dependency only, so a normal Build of the
    Manager also builds the watchdog and CopyWatchdogToOutput below
    can find its output.
  -->
  <ItemGroup>
    <ProjectReference Include="..\GSM.Watchdog\GSM.Watchdog.vbproj" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <UndefineProperties>RuntimeIdentifier</UndefineProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- ============================================================
       GSM.Watchdog deployment (Phase 5m-3)

       The watchdog must sit next to GSM.Manager.exe so it can launch
       and supervise the Manager. Dev (Build) and prod (Publish) need
       different layouts, exactly like GSM.Node -> GSM.CtrlCSender:

         1. BUILD (dev): framework-dependent layout
            (.exe + .dll + .runtimeconfig.json + .deps.json [+ .pdb]
            + watchdogsettings.json) copied next to GSM.Manager.exe.
            The dev machine has .NET 8 installed, so this just runs.
            This is what lets the watchdog be tested straight out of
            bin\$(Configuration)\net8.0-windows\ with no manual copy.

         2. PUBLISH (prod): the Manager publishes self-contained
            single-file, which does NOT lay out a shared framework
            next to the .exe, so a framework-dependent watchdog
            dropped there would fail with "No frameworks were found".
            At publish time we publish the watchdog self-contained
            single-file (one standalone .exe) and copy that in.

       The watchdog is win-x64 (the Manager is Windows-only). Both
       targets are RID-gated for consistency with the Node pattern,
       though the Manager only ever targets win-x64.
       ============================================================ -->

  <!--
    BUILD path: copy the framework-dependent watchdog next to
    GSM.Manager.exe. Condition="Exists('%(Identity)')" on the Copy
    tolerates files absent in some configs (.pdb is Debug-only).
  -->
  <Target Name="CopyWatchdogToOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\GSM.Watchdog.exe" />
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\GSM.Watchdog.dll" />
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\GSM.Watchdog.runtimeconfig.json" />
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\GSM.Watchdog.deps.json" />
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\GSM.Watchdog.pdb" />
      <_WatchdogOutput Include="..\GSM.Watchdog\bin\$(Configuration)\net8.0\watchdogsettings.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_WatchdogOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>

  <!--
    PUBLISH path: publish the watchdog self-contained single-file
    into a dedicated subfolder of its own bin, then copy the
    standalone .exe (and its settings) into the Manager's publish
    folder. BeforeTargets/AfterTargets="Publish" mirrors the Node
    pattern so the .exe is ready when the copy fires. PublishDir is
    pinned to keep the self-contained outputs out of the
    framework-dependent bin the Build path uses.
  -->
  <Target Name="PublishWatchdog" BeforeTargets="Publish" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <!--
      RemoveProperties="TargetFramework" is essential: a Publish sets
      TargetFramework=net8.0-windows as a GLOBAL property for the
      Manager's inner build, and the MSBuild task passes inherited
      globals down to the child. Without removing it the watchdog
      (net8.0 only) is asked to publish as net8.0-windows and fails
      with "Assets file ... doesn't have a target for net8.0-windows".
      The regular ProjectReference above sidesteps this via
      SkipGetTargetFrameworkProperties; this explicit MSBuild call
      needs its own guard. (A plain Build doesn't set TargetFramework
      globally, which is why only Publish tripped on it.)
    -->
    <MSBuild Projects="..\GSM.Watchdog\GSM.Watchdog.vbproj" Targets="Publish" RemoveProperties="TargetFramework" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;EnableWindowsTargeting=true;PublishDir=$(MSBuildThisFileDirectory)..\GSM.Watchdog\bin\$(Configuration)\win-x64\selfcontained\" />
  </Target>

  <Target Name="CopyWatchdogToPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_WatchdogPublish Include="..\GSM.Watchdog\bin\$(Configuration)\win-x64\selfcontained\GSM.Watchdog.exe" />
      <_WatchdogPublish Include="..\GSM.Watchdog\bin\$(Configuration)\win-x64\selfcontained\watchdogsettings.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_WatchdogPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>

</Project>
