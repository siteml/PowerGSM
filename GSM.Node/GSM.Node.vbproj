<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      RuntimeIdentifiers must list every RID this project may be
      published as, so NuGet restore generates a TFM/RID slot for
      each in obj/project.assets.json. Without this, a publish
      that pins -p:RuntimeIdentifier=<rid> while skipping the
      per-publish restore step fails with NETSDK1047 because the
      slot it needs ('net8.0/<rid>') was never created. The CLI
      form `dotnet publish -r <rid>` does a transitive restore
      with the RID applied that compensates, but the release
      workflow relies on the solution-wide restore at the top of
      each job and the publishes use no-restore, so the slots
      have to exist ahead of time.

      Same pattern as GSM.CtrlCSender.vbproj. Add a RID here when
      adding a new platform target to the release workflow.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <RootNamespace></RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <ApplicationIcon>PowerGSM.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PowerGSM.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GSM.Contracts\GSM.Contracts.vbproj" />

    <!--
      GSM.Shim.Protocol is a normal managed reference: the Node links it
      to speak the shim wire protocol (FrameConnection, SpawnSpec, the
      transport). Cross-platform (declares win-x64;linux-x64), so no RID
      gating is needed.
    -->
    <ProjectReference Include="..\GSM.Shim.Protocol\GSM.Shim.Protocol.vbproj" />

    <!--
      GSM.CtrlCSender is a runtime helper, not a referenced
      assembly. Build-order dependency only: ReferenceOutputAssembly=false
      keeps Roslyn from trying to link an Exe as a managed reference,
      Private=false keeps it out of our publish closure as a referenced
      DLL (we copy it explicitly via the targets below), and
      SkipGetTargetFrameworkProperties=true silences the TFM-mismatch
      warning that would otherwise fire for an OutputType=Exe project.

      UndefineProperties=RuntimeIdentifier prevents the parent's RID
      from propagating into CtrlCSender's regular Build via the
      project reference. Without this, a `dotnet publish -r linux-x64`
      of GSM.Node tries to build CtrlCSender as net8.0/linux-x64 and
      fails with NETSDK1047 because CtrlCSender only declares win-x64
      in its RuntimeIdentifiers (it's a Windows-only helper). The
      win-x64 self-contained .exe we actually ship is produced by
      PublishCtrlCSender's inner MSBuild call below, which passes
      RuntimeIdentifier=win-x64 explicitly and is unaffected by this
      scrub. The regular Build of CtrlCSender just needs the no-RID
      net8.0 slot, which restore always generates.

      Condition gates the ProjectReference itself on the RID, with
      the same expression the publish-side targets below use. As of
      the v0.3.0 release attempts, UndefineProperties=RuntimeIdentifier
      alone stopped being sufficient — the Linux job's Node publish
      started getting NETSDK1047 against CtrlCSender's net8.0/linux-x64
      slot despite the scrub, likely a .NET 8 SDK update changing how
      project-graph evaluation handles property scrubbing. Conditioning
      the reference itself dodges the issue at the source: on Linux
      publish the reference is excluded entirely, so MSBuild never
      asks CtrlCSender about any RID. Restore happens with empty RID
      (the workflow's per-project restore doesn't pin one), so the
      reference IS included at restore time and CtrlCSender's assets
      get generated normally. Restore-time-included, publish-time-
      excluded — same end result UndefineProperties was aiming for,
      just via a more durable mechanism.
    -->
    <ProjectReference Include="..\GSM.CtrlCSender\GSM.CtrlCSender.vbproj"
                      Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <UndefineProperties>RuntimeIdentifier</UndefineProperties>
    </ProjectReference>

    <!--
      GSM.Shim is the per-instance supervisor exe the Node spawns at
      runtime. Like CtrlCSender it's a build-order dependency only
      (ReferenceOutputAssembly=false — never linked; the Node talks to it
      over a pipe/socket, not via its types), but UNLIKE CtrlCSender it is
      cross-platform: the Linux node needs it too. So there is NO win-only
      condition here, and the co-location targets below deploy it on every
      RID. UndefineProperties=RuntimeIdentifier keeps the build-order
      reference producing the plain net8.0 build output the Build-path copy
      consumes; the publish path drives a RID-specific self-contained
      publish explicitly.
    -->
    <ProjectReference Include="..\GSM.Shim\GSM.Shim.vbproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <UndefineProperties>RuntimeIdentifier</UndefineProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="SharpCompress" Version="0.36.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nodesettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ============================================================
       GSM.CtrlCSender deployment

       The helper is a tiny console app that GSM.Node spawns to
       deliver CTRL_C_EVENT to UE4 game-server children. It must
       sit next to GSM.Node.exe at runtime in both dev and prod.

       Dev (Build) and prod (Publish) need different layouts:

         1. BUILD (dev): Helper is framework-dependent. The dev
            machine has .NET 8 installed, so the regular
            (.exe + .dll + .runtimeconfig.json + .deps.json) layout
            works. Output is tiny (around 200KB), incremental builds
            stay fast.

         2. PUBLISH (prod): Helper is self-contained single-file.
            GSM.Node is typically published self-contained, which
            packs the .NET runtime into Node's own publish output
            but does NOT lay out a sharable framework next to it
            (no shared\Microsoft.NETCore.App\version\ directory).
            A framework-dependent helper dropped into that publish
            folder fails to launch with "No frameworks were found"
            because its apphost can't see a usable framework.
            So at publish time we explicitly publish the helper as
            self-contained / single-file, producing one standalone
            .exe (~15MB) that has zero external dependencies.

       The helper is hardcoded to win-x64 because:
         * It's Windows-only (P/Invokes kernel32 console APIs).
         * The runtime caller (ProcessManager.TrySendConsoleCtrlC)
           is gated behind OperatingSystem.IsWindows() so it only
           runs on Windows hosts anyway.

       Both the Build-side and Publish-side targets below are
       gated on the RID: skipped when RuntimeIdentifier is set and
       doesn't start with 'win', so a `dotnet publish -r linux-x64`
       produces a clean Linux deployment without a stray Windows
       .exe. The Build gate matters because Microsoft.NET.Sdk.Web
       sweeps the build OutDir into the publish dir as part of
       its standard publish flow — anything CopyCtrlCSenderToOutput
       drops there at Build time gets carried into Publish whether
       the publish-time gate fires or not. Locking the front door
       isn't enough; the build-side door has to be locked too.
       When RID is unset (legacy framework-dependent publish, no
       platform commitment) the helper is still included on the
       Windows-bias assumption.

       EnableWindowsTargeting=true is set on the inner MSBuild call
       (and on direct CLI builds via PowerGSM's CI workflow) so this
       cross-compile works from a Linux build host. The .NET 8 SDK
       requires that flag whenever a self-contained publish targets
       a win-* RID from a non-Windows OS, even when the project's
       TargetFramework is plain net8.0 (as CtrlCSender's is) — the
       check fires on the RID + SelfContained combination, not on
       the TFM. On Windows hosts the flag is a no-op.
       ============================================================ -->

  <!--
    BUILD path: copy the framework-dependent helper next to
    GSM.Node.exe. Works at dev time because the dev machine has
    .NET 8 installed. Condition="Exists('%(Identity)')" on the
    Copy task tolerates files that don't exist in every config
    (e.g. .pdb is normally only present in Debug). Target-level
    Condition gates on RID so a Linux publish doesn't pull the
    Windows .exe through the OutDir-to-PublishDir sweep that the
    Web SDK does as part of its standard publish flow.
  -->
  <Target Name="CopyCtrlCSenderToOutput" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_CtrlCSenderOutput Include="..\GSM.CtrlCSender\bin\$(Configuration)\net8.0\GSM.CtrlCSender.exe" />
      <_CtrlCSenderOutput Include="..\GSM.CtrlCSender\bin\$(Configuration)\net8.0\GSM.CtrlCSender.dll" />
      <_CtrlCSenderOutput Include="..\GSM.CtrlCSender\bin\$(Configuration)\net8.0\GSM.CtrlCSender.runtimeconfig.json" />
      <_CtrlCSenderOutput Include="..\GSM.CtrlCSender\bin\$(Configuration)\net8.0\GSM.CtrlCSender.deps.json" />
      <_CtrlCSenderOutput Include="..\GSM.CtrlCSender\bin\$(Configuration)\net8.0\GSM.CtrlCSender.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_CtrlCSenderOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')" />
  </Target>

  <!--
    PUBLISH path: invoke a self-contained single-file Publish of
    the helper into a dedicated subfolder of its own bin, then
    copy the resulting one-file .exe next to GSM.Node.exe in
    Node's publish folder.

    BeforeTargets="Publish" runs after Node's Build but before
    its Publish copy logic, so the helper's .exe is ready when
    CopyCtrlCSenderToPublish (AfterTargets="Publish") fires.

    PublishDir is set explicitly to keep these self-contained
    outputs separate from the framework-dependent bin output that
    the Build path uses; otherwise a Build after a Publish would
    see ~200 runtime DLLs sitting where the framework-dependent
    output is supposed to be.
  -->
  <Target Name="PublishCtrlCSender" BeforeTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <MSBuild Projects="..\GSM.CtrlCSender\GSM.CtrlCSender.vbproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;EnableWindowsTargeting=true;PublishDir=$(MSBuildThisFileDirectory)..\GSM.CtrlCSender\bin\$(Configuration)\win-x64\selfcontained\" />
  </Target>

  <Target Name="CopyCtrlCSenderToPublish" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <Copy SourceFiles="..\GSM.CtrlCSender\bin\$(Configuration)\win-x64\selfcontained\GSM.CtrlCSender.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- ============================================================
       GSM.Shim deployment (Phase 8-1)

       GSM.Shim is the per-instance supervisor the Node spawns. It is
       versioned side-by-side on disk (decision 6): the Node launches
       GSM.Shim\<version>\GSM.Shim(.exe), and a running shim is never
       overwritten. So both the Build and Publish drops land in a
       version subfolder, not next to GSM.Node directly.

       Unlike CtrlCSender, the shim is cross-platform — the Linux node
       runs it too — so these targets are NOT gated on a win RID. The
       publish path publishes the shim self-contained / single-file for
       whatever RID the Node is being published as.

       $(Version) comes from Directory.Build.props (stamped identically
       across every project), so it matches the shim's own self-reported
       version (ShimVersionInfo strips the +sha to the same base).
       ============================================================ -->

  <!--
    BUILD path (dev): copy the framework-dependent shim output into
    $(OutDir)GSM.Shim\$(Version)\ so a dev run of the Node finds it.
    Includes GSM.Shim.Protocol.dll (the shim's only managed dependency).
    Gated on RID being unset so a RID-set publish does NOT drop
    framework-dependent files that would pollute the self-contained
    publish output (the publish path below handles RID builds). Exists()
    guards tolerate per-config/per-OS differences (no .pdb in some
    configs; .exe on Windows vs extensionless apphost on Linux).
  -->
  <Target Name="CopyShimToOutput" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.exe" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.dll" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.runtimeconfig.json" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.deps.json" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.pdb" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.Protocol.dll" />
      <_ShimBuildOutput Include="..\GSM.Shim\bin\$(Configuration)\net8.0\GSM.Shim.Protocol.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShimBuildOutput)"
          DestinationFolder="$(OutDir)GSM.Shim\$(Version)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')" />
  </Target>

  <!--
    PUBLISH path (prod): publish the shim self-contained / single-file for
    the Node's target RID into a dedicated subfolder, then copy the one
    resulting binary into $(PublishDir)GSM.Shim\$(Version)\.

    Gated on RuntimeIdentifier being set: a self-contained single-file
    publish needs a RID. When RID is unset (framework-dependent publish)
    the Build-path drop above is swept into PublishDir by the Web SDK, so
    the shim is still present.

    EnableWindowsTargeting=true lets a win-x64 shim publish from a Linux
    CI host (no-op on Windows / for linux-x64), matching CtrlCSender.
  -->
  <Target Name="PublishShim" BeforeTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\GSM.Shim\GSM.Shim.vbproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=true;EnableWindowsTargeting=true;PublishDir=$(MSBuildThisFileDirectory)..\GSM.Shim\bin\$(Configuration)\$(RuntimeIdentifier)\selfcontained\" />
  </Target>

  <Target Name="CopyShimToPublish" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_ShimPublished Include="..\GSM.Shim\bin\$(Configuration)\$(RuntimeIdentifier)\selfcontained\GSM.Shim.exe" />
      <_ShimPublished Include="..\GSM.Shim\bin\$(Configuration)\$(RuntimeIdentifier)\selfcontained\GSM.Shim" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShimPublished)"
          DestinationFolder="$(PublishDir)GSM.Shim\$(Version)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')" />
  </Target>

</Project>
