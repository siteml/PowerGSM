<!--
  ============================================================
   Directory.Build.targets — solution-wide build targets

   MSBuild auto-imports this file into every project under the
   solution root (the .targets counterpart of Directory.Build.props,
   imported AFTER the project body so targets can see project
   properties like AssemblyName).

   Currently hosts one thing: the EMBEDDED BUILD MARKER
   (Phase 8-2 follow-up 5a). For GSM.Node, GSM.Shim and
   GSM.NodeSetup a small VB source file is generated into the
   intermediate output dir and compiled in, carrying

       PGSMBUILD|<component>|<version>|<rid>|

   as a String constant. .NET string constants land verbatim
   (UTF-16LE) in assembly metadata — including inside
   self-contained single-file bundles, since compression
   (EnableCompressionInSingleFile) is not enabled anywhere in
   this solution — so the component/version/platform of any
   shipped binary can be read from its BYTES without executing
   it. That is the fix for the July 2026 failure mode: a Linux
   ELF on a Windows disk is version-anonymous and cannot be
   executed to ask. The Manager's Update Nodes file picker
   scans picked files for this marker (UTF-16LE and UTF-8) and
   shows what was picked BEFORE upload.

   Shape notes:
     - The trailing '|' is the parse TERMINATOR: metadata packs
       the next heap entry right behind the constant, so the
       scanner needs a definite end for the <rid> field.
     - <component> is the project/assembly name (GSM.Node,
       GSM.Shim, GSM.NodeSetup, GSM.CtrlCSender); <version> is $(Version) from
       Directory.Build.props; <rid> is the pinned publish
       RuntimeIdentifier, falling back to the SDK host RID for
       plain dev builds so the marker is never empty.
     - The generated constants also back the binaries'
       version-flag fast path (follow-up 5b), so the printed
       identity and the byte-scannable identity can never drift.

   WriteOnlyWhenDifferent keeps incremental builds quiet; the
   file is declared in @(FileWrites) so Clean removes it.
  ============================================================
-->
<Project>

  <Target Name="PgsmGenerateBuildMarker"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'GSM.Node' Or '$(MSBuildProjectName)' == 'GSM.Shim' Or '$(MSBuildProjectName)' == 'GSM.NodeSetup' Or '$(MSBuildProjectName)' == 'GSM.CtrlCSender'">

    <PropertyGroup>
      <_PgsmRid>$(RuntimeIdentifier)</_PgsmRid>
      <_PgsmRid Condition="'$(_PgsmRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_PgsmRid>
      <_PgsmRid Condition="'$(_PgsmRid)' == ''">unknown</_PgsmRid>
      <_PgsmMarker>PGSMBUILD|$(MSBuildProjectName)|$(Version)|$(_PgsmRid)|</_PgsmMarker>
      <_PgsmMarkerFile>$(IntermediateOutputPath)PgsmBuildMarker.g.vb</_PgsmMarkerFile>
    </PropertyGroup>

    <ItemGroup>
      <_PgsmMarkerLine Include="' &lt;auto-generated&gt;" />
      <_PgsmMarkerLine Include="'   PowerGSM embedded build marker (Phase 8-2 follow-up 5a)." />
      <_PgsmMarkerLine Include="'   Generated by Directory.Build.targets at build time. DO NOT EDIT," />
      <_PgsmMarkerLine Include="'   DO NOT CHECK IN (lives under obj\)." />
      <_PgsmMarkerLine Include="' &lt;/auto-generated&gt;" />
      <_PgsmMarkerLine Include="Namespace Global.PowerGSM.BuildInfo" />
      <_PgsmMarkerLine Include="Public Module PgsmBuildMarker" />
      <_PgsmMarkerLine Include="Public Const Component As String = &quot;$(MSBuildProjectName)&quot;" />
      <_PgsmMarkerLine Include="Public Const BuildVersion As String = &quot;$(Version)&quot;" />
      <_PgsmMarkerLine Include="Public Const Rid As String = &quot;$(_PgsmRid)&quot;" />
      <_PgsmMarkerLine Include="Public Const Marker As String = &quot;$(_PgsmMarker)&quot;" />
      <_PgsmMarkerLine Include="End Module" />
      <_PgsmMarkerLine Include="End Namespace" />
    </ItemGroup>

    <WriteLinesToFile File="$(_PgsmMarkerFile)"
                      Lines="@(_PgsmMarkerLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_PgsmMarkerFile)" />
      <FileWrites Include="$(_PgsmMarkerFile)" />
    </ItemGroup>

  </Target>

  <!--
    ============================================================
     UPLOADABLE DROP FOLDER (2026-10-10)

     Manual node updates (Nodes → Update Nodes) take ONE self-
     contained single-file binary per component: GSM.Node.exe /
     GSM.Shim.exe / GSM.NodeSetup.exe on Windows, the bare
     extension-less names on Linux. Those land in three different
     per-project publish folders, which is how a plain-Build apphost
     stub got pushed by mistake (2026-10-10 morning — every Windows
     node died).

     After each publish of those three projects this target copies
     just that one binary into a single solution-root folder:

         publish-drop\<version>\GSM.Node.exe   GSM.Node   (etc.)

     Versioned so a stale build can't be confused with the current
     one. Windows (.exe) and Linux (no extension) names don't clash,
     so no per-RID subfolder. Filenames stay canonical because
     the Update Nodes picker filters on them. publish-drop\ is
     gitignored. Only fires on a real RID-pinned publish (VS publish
     profile or the release workflow); a RID-less dev build has no
     single-file output to collect. The Manager is deliberately NOT
     collected — its self-update takes the release zip, not a bare
     exe.
    ============================================================
  -->
  <Target Name="PgsmCollectUploadable"
          AfterTargets="Publish"
          Condition="('$(MSBuildProjectName)' == 'GSM.Node' Or '$(MSBuildProjectName)' == 'GSM.Shim' Or '$(MSBuildProjectName)' == 'GSM.NodeSetup') And '$(RuntimeIdentifier)' != ''">

    <PropertyGroup>
      <_PgsmDropExt Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</_PgsmDropExt>
      <_PgsmDropSrc>$(PublishDir)$(AssemblyName)$(_PgsmDropExt)</_PgsmDropSrc>
      <_PgsmDropDir>$(MSBuildThisFileDirectory)publish-drop\$(Version)\</_PgsmDropDir>
    </PropertyGroup>

    <!--
      Hard errors, not warnings: the whole point is to never again hand
      the picker the wrong file. A framework-dependent or multi-file
      publish ALSO writes a $(AssemblyName).exe (the apphost stub), so
      checking the file exists is not enough — check the publish shape
      itself. Both properties come from the pubxml (VS) or the -p: pins
      (release workflow).
    -->
    <Error Condition="'$(SelfContained)' != 'true' Or '$(PublishSingleFile)' != 'true'"
           Text="PgsmCollectUploadable: this publish is not SelfContained + PublishSingleFile (SelfContained='$(SelfContained)', PublishSingleFile='$(PublishSingleFile)'). The output would be an apphost stub that dies on the node. Publish with the RID profile." />
    <Error Condition="!Exists('$(_PgsmDropSrc)')"
           Text="PgsmCollectUploadable: expected binary not found at $(_PgsmDropSrc)." />

    <MakeDir Directories="$(_PgsmDropDir)" />
    <Copy SourceFiles="$(_PgsmDropSrc)"
          DestinationFolder="$(_PgsmDropDir)"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Message Importance="high"
             Text="Uploadable: $(_PgsmDropDir)$(AssemblyName)$(_PgsmDropExt)" />

  </Target>

  <!--
    CtrlCSender (2026-10-11): the 4th Update Nodes target. It is never
    published on its own — GSM.Node's PublishCtrlCSender inner build
    produces the self-contained win-x64 exe and copies it into the Node
    publish dir — so collect it from there after a WINDOWS Node publish.
    Linux nodes don't have it (the helper P/Invokes kernel32).
  -->
  <Target Name="PgsmCollectCtrlCSender"
          AfterTargets="CopyCtrlCSenderToPublish"
          Condition="'$(MSBuildProjectName)' == 'GSM.Node' And $(RuntimeIdentifier.StartsWith('win')) And '$(SelfContained)' == 'true' And '$(PublishSingleFile)' == 'true'">

    <PropertyGroup>
      <_PgsmCtrlSrc>$(PublishDir)GSM.CtrlCSender.exe</_PgsmCtrlSrc>
      <_PgsmCtrlDropDir>$(MSBuildThisFileDirectory)publish-drop\$(Version)\</_PgsmCtrlDropDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PgsmCtrlSrc)')"
           Text="PgsmCollectCtrlCSender: GSM.CtrlCSender.exe not found at $(_PgsmCtrlSrc)." />

    <MakeDir Directories="$(_PgsmCtrlDropDir)" />
    <Copy SourceFiles="$(_PgsmCtrlSrc)"
          DestinationFolder="$(_PgsmCtrlDropDir)"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Message Importance="high"
             Text="Uploadable: $(_PgsmCtrlDropDir)GSM.CtrlCSender.exe" />

  </Target>

  <!--
    ============================================================
     FRESH-NODE INSTALL SET (2026-10-10)

     publish-drop\<version>\ holds UPDATE binaries only. A brand-new
     node box needs more than GSM.Node + GSM.NodeSetup: the single-file
     bundle leaves NATIVE libs loose (e_sqlite3.dll — without it the
     node dies at NodeDatabase.EnsureCreated with an unhandled
     DllNotFoundException, found live 2026-10-10), plus the shim in its
     version folder, CtrlCSender (Windows), and the nodesettings.json
     template. After a Node RID publish this copies exactly that set to

         publish-drop\<version>\node-fresh-<rid>\

     Copy the folder to the new box, run GSM.NodeSetup, start the node.
     Logs\data are NOT included (the publish folder is never run from,
     unlike the Manager's, but exclude them anyway).
    ============================================================
  -->
  <Target Name="PgsmCollectFreshNode"
          AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'GSM.Node' And '$(RuntimeIdentifier)' != '' And '$(SelfContained)' == 'true' And '$(PublishSingleFile)' == 'true'">

    <PropertyGroup>
      <_PgsmDropExt Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</_PgsmDropExt>
      <_PgsmFreshDir>$(MSBuildThisFileDirectory)publish-drop\$(Version)\node-fresh-$(RuntimeIdentifier)\</_PgsmFreshDir>
    </PropertyGroup>

    <ItemGroup>
      <_PgsmFreshFiles Include="$(PublishDir)GSM.Node$(_PgsmDropExt)" />
      <!-- NodeSetup usually is NOT here yet: the Node publish clears its
           folder and NodeSetup's own publish (DeployToNodeFolder) puts the
           survivor back afterwards. PgsmCollectFreshNodeSetup below adds it
           from NodeSetup's publish regardless of order. -->
      <_PgsmFreshFiles Include="$(PublishDir)GSM.NodeSetup$(_PgsmDropExt)" Condition="Exists('$(PublishDir)GSM.NodeSetup$(_PgsmDropExt)')" />
      <_PgsmFreshFiles Include="$(PublishDir)GSM.CtrlCSender.exe" Condition="Exists('$(PublishDir)GSM.CtrlCSender.exe')" />
      <_PgsmFreshFiles Include="$(PublishDir)nodesettings.json" Condition="Exists('$(PublishDir)nodesettings.json')" />
      <!-- Loose natives: everything that is not a managed bundle. -->
      <_PgsmFreshFiles Include="$(PublishDir)*.dll" />
      <_PgsmFreshFiles Include="$(PublishDir)*.so" />
      <!-- Shim: separate item so the GSM.Shim\ level survives. %(RecursiveDir)
           is relative to the glob's fixed prefix (GSM.Shim\), i.e. just
           "<version>\" — copying with it alone landed GSM.Shim.exe in
           node-fresh\<version>\ instead of node-fresh\GSM.Shim\<version>\
           (2026-10-11). -->
      <_PgsmFreshShim Include="$(PublishDir)GSM.Shim\**\*" />
    </ItemGroup>

    <Error Condition="!Exists('$(PublishDir)e_sqlite3.dll') And $(RuntimeIdentifier.StartsWith('win'))"
           Text="PgsmCollectFreshNode: e_sqlite3.dll not found in $(PublishDir) — the fresh-install set would not start." />
    <Error Condition="'@(_PgsmFreshShim->Count())' == '0'"
           Text="PgsmCollectFreshNode: no shim under $(PublishDir)GSM.Shim\ — PublishShim did not run?" />

    <MakeDir Directories="$(_PgsmFreshDir)" />
    <Copy SourceFiles="@(_PgsmFreshFiles)"
          DestinationFiles="@(_PgsmFreshFiles->'$(_PgsmFreshDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Copy SourceFiles="@(_PgsmFreshShim)"
          DestinationFiles="@(_PgsmFreshShim->'$(_PgsmFreshDir)GSM.Shim\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Message Importance="high"
             Text="Fresh-node set: @(_PgsmFreshFiles->Count()) + @(_PgsmFreshShim->Count()) shim file(s) to $(_PgsmFreshDir)" />

  </Target>

  <!--
    NodeSetup into the fresh-node set, from ITS OWN publish (runs after its
    DeployToNodeFolder so it is independent of Node-vs-NodeSetup publish
    order; the Node publish wipes NodeSetup from the node folder, which is
    why the Node-side collect above usually can't see it). Same
    RID-pinned, single-file gate as the uploadable copy.
  -->
  <Target Name="PgsmCollectFreshNodeSetup"
          AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'GSM.NodeSetup' And '$(RuntimeIdentifier)' != '' And '$(SelfContained)' == 'true' And '$(PublishSingleFile)' == 'true'">

    <PropertyGroup>
      <_PgsmNsExt Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</_PgsmNsExt>
      <_PgsmNsSrc>$(PublishDir)GSM.NodeSetup$(_PgsmNsExt)</_PgsmNsSrc>
      <_PgsmNsFreshDir>$(MSBuildThisFileDirectory)publish-drop\$(Version)\node-fresh-$(RuntimeIdentifier)\</_PgsmNsFreshDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PgsmNsSrc)')"
           Text="PgsmCollectFreshNodeSetup: GSM.NodeSetup binary not found at $(_PgsmNsSrc)." />

    <MakeDir Directories="$(_PgsmNsFreshDir)" />
    <Copy SourceFiles="$(_PgsmNsSrc)"
          DestinationFolder="$(_PgsmNsFreshDir)"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Message Importance="high"
             Text="Fresh-node set: $(_PgsmNsFreshDir)GSM.NodeSetup$(_PgsmNsExt)" />

  </Target>

  <!--
    ============================================================
     MANAGER DROP FOLDER (2026-10-10)

     The Manager is a single-file exe plus a handful of LOOSE files
     that must travel with it (ExcludeFromSingleFile /
     IncludeNativeLibrariesForSelfExtract=false): GSM.Contracts.dll
     (Roslyn needs it on disk), e_sqlite3 + WebView2Loader + the
     *_cor3 WPF natives, runtimes\ (per-RID natives), Plugins\ (the
     bundled plugin sources PluginRegistry compiles), GSM.Watchdog.exe
     and watchdogsettings.json. Hand-updating a second Manager by
     guessing which of those matter is how a copy goes wrong, and the
     publish folder on the dev box is also RUN from, so it carries
     live state (gsm.db, logs\, .updates\, .plugin-updates\,
     watchdog.log) that must NOT be copied over another install.

     After a RID publish of GSM.Manager this copies exactly the
     shipped set into publish-drop\<version>\Manager\. Drop that
     folder's contents over the other install (it never contains
     gsm.db or logs, so nothing of the target's state is touched).
     .pdb files are left out too.
    ============================================================
  -->
  <Target Name="PgsmCollectManager"
          AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'GSM.Manager' And '$(RuntimeIdentifier)' != ''">

    <Error Condition="'$(SelfContained)' != 'true' Or '$(PublishSingleFile)' != 'true'"
           Text="PgsmCollectManager: this publish is not SelfContained + PublishSingleFile (SelfContained='$(SelfContained)', PublishSingleFile='$(PublishSingleFile)'). Publish with the FolderProfile." />

    <PropertyGroup>
      <_PgsmMgrDropDir>$(MSBuildThisFileDirectory)publish-drop\$(Version)\Manager\</_PgsmMgrDropDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- Top-level shipped files: exes, loose DLLs, the watchdog defaults. -->
      <_PgsmMgrFiles Include="$(PublishDir)*.exe" />
      <_PgsmMgrFiles Include="$(PublishDir)*.dll" />
      <_PgsmMgrFiles Include="$(PublishDir)watchdogsettings.json" />
      <_PgsmMgrFiles Include="$(PublishDir)BUILD-INFO.json" Condition="Exists('$(PublishDir)BUILD-INFO.json')" />
      <!-- Shipped subtrees. -->
      <_PgsmMgrFiles Include="$(PublishDir)runtimes\**\*" />
      <_PgsmMgrFiles Include="$(PublishDir)Plugins\**\*" />
    </ItemGroup>

    <Error Condition="!Exists('$(PublishDir)GSM.Manager.exe') Or !Exists('$(PublishDir)GSM.Contracts.dll')"
           Text="PgsmCollectManager: GSM.Manager.exe or GSM.Contracts.dll missing from $(PublishDir) - publish shape is wrong." />

    <MakeDir Directories="$(_PgsmMgrDropDir)" />
    <Copy SourceFiles="@(_PgsmMgrFiles)"
          DestinationFiles="@(_PgsmMgrFiles->'$(_PgsmMgrDropDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />
    <Message Importance="high"
             Text="Manager drop: @(_PgsmMgrFiles->Count()) file(s) to $(_PgsmMgrDropDir)" />

  </Target>

</Project>
