{
  "ConnectionStrings": {
    "Default": "Data Source=gsm.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Manager": {
    "PluginsDirectory": "plugins",
    "MetricsPollIntervalSec": 30,
    "VersionPollIntervalMin": 15,
    "LogBufferLineCap": 10000,
    "RuleHistoryCapPerRule": 100,
    "NodeConnectTimeoutSec": 10,
    "NodeRequestTimeoutSec": 30
  }
}
